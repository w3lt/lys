---
import { ChevronRight } from "lucide-react"
import NavigationIcon from "@/components/handbook/NavigationIcon.astro"
import {
  containsCurrentPage,
  type NavigationEntry
} from "@/lib/handbook/navigation"

/** Edge length of a disclosure chevron, in pixels, as specified by the design. */
const CARET_SIZE = 14

/** Stroke weight of a disclosure chevron, as specified by the design. */
const CARET_STROKE_WIDTH = 1.7

type NavigationTreeProps = {
  /** Entries to render at this level, in the order they should appear. */
  readonly entries: readonly NavigationEntry[]
  /**
   * Whether this level sits below the top level.
   *
   * Only top-level entries carry a section icon, and only levels below the top
   * are drawn against the design's indent rule. Omit at the root.
   */
  readonly nested?: boolean
}

/** Astro types `Astro.props` from a local declaration named `Props`. */
type Props = NavigationTreeProps

const { entries, nested = false }: NavigationTreeProps = Astro.props
---

{/**
  * The handbook navigation tree, rendered with the design's section icons.
  *
  * Composition/view connecting the navigation use case. It projects the tree
  * Starlight publishes on `Astro.locals.starlightRoute.sidebar`, so sidebar
  * configuration, autogeneration, ordering, and current-page marking stay
  * Starlight's responsibility; this component owns only the rail's appearance
  * and its disclosure structure. It renders itself recursively for nested
  * groups.
  *
  * State authority: none of its own. A group's open state is a native
  * `details` element, so it survives without client JavaScript and resets on
  * navigation to the group holding the current page.
  *
  * Rendered result: one `ul`. An empty `entries` list renders an empty list,
  * which is the correct successful result for a section with no pages yet.
  *
  * Accessibility: groups use native disclosure semantics, and the current page
  * is marked with `aria-current="page"` rather than by appearance alone.
  * Section icons and chevrons are decorative and hidden from assistive
  * technology.
  */}
<ul class:list={["tree", { nested }]}>
  {
    entries.map((entry) => (
      <li>
        {entry.type === "link" ? (
          <a
            href={entry.href}
            aria-current={entry.isCurrent ? "page" : undefined}
            class:list={["row", { section: !nested }]}
            {...entry.attrs}
          >
            {!nested && <NavigationIcon section={entry.label} />}
            <span class="label">{entry.label}</span>
          </a>
        ) : (
          <details open={containsCurrentPage(entry)}>
            <summary
              class:list={["row", { section: !nested }]}
              data-current-section={
                !nested && containsCurrentPage(entry) ? "" : undefined
              }
            >
              {!nested && <NavigationIcon section={entry.label} />}
              <span class="label">{entry.label}</span>
              <ChevronRight
                size={CARET_SIZE}
                strokeWidth={CARET_STROKE_WIDTH}
                aria-hidden="true"
                focusable="false"
                className="caret"
              />
            </summary>
            <Astro.self entries={entry.entries} nested />
          </details>
        )}
      </li>
    ))
  }
</ul>

<style>
  .tree {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The design draws every level below the top against one indent rule. */
  .tree.nested {
    gap: 0.0625rem;
    margin: 0.25rem 0 0.625rem 1.375rem;
    padding-inline-start: 0.875rem;
    border-inline-start: 1px solid var(--app-border-subtle);
    animation: lys-reveal var(--duration-enter) var(--ease-standard) both;
  }

  li {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .row {
    display: flex;
    gap: 0.375rem;
    align-items: center;
    padding: 0.3125rem 0.625rem;
    border-radius: var(--radius-control);
    color: var(--doc-text-muted);
    font-size: 0.8125rem;
    line-height: 1.45;
    text-decoration: none;
    transition:
      color var(--duration-standard) var(--ease-standard),
      background-color var(--duration-standard) var(--ease-standard);
  }

  .row.section {
    gap: 0.75rem;
    padding: 0.5rem 0.6875rem;
    border-radius: 0.5625rem;
    font-size: 0.875rem;
    letter-spacing: -0.005em;
    cursor: pointer;
    user-select: none;
  }

  summary.row::marker,
  summary.row::-webkit-details-marker {
    display: none;
  }

  .label {
    flex: 1;
    min-width: 0;
  }

  .row.section .label {
    white-space: nowrap;
  }

  .row:hover,
  .row:focus-visible {
    background-color: var(--app-surface-hover);
    color: var(--app-text-strong);
  }

  .row:focus-visible {
    outline: 2px solid var(--lys-cyan);
    outline-offset: 2px;
  }

  /*
   * Two different active treatments, exactly as the design separates them: the
   * section holding the current page is lifted with a violet bloom, while the
   * current page itself is marked with a cyan edge.
   */
  [data-current-section] {
    background-color: var(--app-surface-navigation-active);
    box-shadow:
      inset 0 0 0 1px var(--app-border-subtle),
      -18px 0 44px -24px oklch(0.65 0.22 303 / 90%);
    color: var(--app-text-strong);
  }

  [aria-current="page"],
  [aria-current="page"]:hover,
  [aria-current="page"]:focus-visible {
    background-color: var(--app-surface-navigation-active);
    box-shadow: inset 2px 0 0 0 var(--lys-cyan);
    color: var(--app-text-strong);
  }

  .row.section :global(.caret) {
    flex: 0 0 auto;
    opacity: 0.45;
    transition: transform var(--duration-enter) var(--ease-standard);
  }

  details[open] > summary :global(.caret) {
    transform: rotate(90deg);
  }

  [data-current-section] :global(.navigation-icon) {
    color: var(--lys-cyan);
  }

  /*
   * Collapsed rail: only the top-level glyphs remain, so labels, chevrons, and
   * whole subtrees are removed rather than clipped.
   */
  :global(html[data-rail="collapsed"]) .tree.nested,
  :global(html[data-rail="collapsed"]) .row.section .label,
  :global(html[data-rail="collapsed"]) .row.section :global(.caret) {
    display: none;
  }

  :global(html[data-rail="collapsed"]) .row.section {
    justify-content: center;
    padding: 0.5625rem;
  }

  @keyframes lys-reveal {
    from {
      opacity: 0;
      transform: translateY(-5px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
