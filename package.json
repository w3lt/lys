{
  "name": "lys",
  "version": "0.3.0",
  "description": "Lysiptera Caliginia",
  "private": true,
  "author": {
    "name": "Welt",
    "email": "w3lt@negentropy.studio",
    "url": "https://github.com/w3lt"
  },
  "scripts": {
    "prettier:write": "prettier . --write",
    "eslint:write": "eslint . --fix",
    "dev": "pnpm --filter @lys/desktop run tauri dev",
    "docs:dev": "pnpm --filter @lys/docs run dev",
    "backend:dev": "LYS_HOME=\"${LYS_HOME:-$HOME/.lys}\" pnpm --filter @lys/backend run dev",
    "backend:build": "pnpm --filter @lys/backend run build",
    "desktop:build": "pnpm --filter @lys/desktop run tauri build",
    "desktop:build:ci": "pnpm --filter @lys/desktop run tauri build --no-bundle",
    "desktop:bundle:ci": "pnpm --filter @lys/desktop run tauri bundle --bundles app",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-dom": "^5.21.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-react-x": "^5.21.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.9",
    "typescript-eslint": "^8.71.0"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "!(*.js|*.jsx|*.mjs|*.cjs|*.ts|*.tsx|*.mts|*.cts)": "prettier --write --ignore-unknown"
  },
  "packageManager": "pnpm@11.17.0"
}
