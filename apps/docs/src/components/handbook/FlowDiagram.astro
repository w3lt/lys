---
type FlowNode = {
  /** Name of the participant. */
  readonly label: string
  /** What the participant contributes at this point, in a few words. */
  readonly detail: string
}

type FlowDiagramProps = {
  /** Short title shown in the figure's header bar. */
  readonly title: string
  /** Participants on the primary path, left to right. */
  readonly path: readonly FlowNode[]
  /** Participants the primary path fans out to. */
  readonly outputs: readonly FlowNode[]
  /**
   * Prose explanation of what the diagram shows.
   *
   * Required: no information in the handbook may be available only as a
   * picture, so a diagram always carries its own written explanation.
   */
  readonly caption: string
}

/** Astro types `Astro.props` from a local declaration named `Props`. */
type Props = FlowDiagramProps

const { title, path, outputs, caption }: FlowDiagramProps = Astro.props
---

{/**
  * Figure showing a linear flow that fans out to several consumers.
  *
  * Presentational component. Built from text nodes rather than a rendered
  * image, so the participants stay selectable, searchable, and legible at every
  * width without a second accessible representation.
  *
  * Accessibility: the arrows and the connector are decorative. The flow's
  * meaning is carried by the required caption, which is associated with the
  * figure through `<figcaption>`.
  */}
<figure class="flow not-content">
  <div class="frame">
    <div class="header">
      <span>{title}</span>
      <span class="kind">diagram · static</span>
    </div>
    <div class="canvas">
      <ol class="path">
        {
          path.map((node, index) => (
            <li>
              <span class="node">
                <span class="label">{node.label}</span>
                <span class="detail">{node.detail}</span>
              </span>
              {index < path.length - 1 && (
                <span class="arrow" aria-hidden="true">
                  →
                </span>
              )}
            </li>
          ))
        }
      </ol>
      <span class="connector" aria-hidden="true"></span>
      <ul class="outputs">
        {
          outputs.map((node) => (
            <li>
              <span class="node dashed">
                <span class="label">{node.label}</span>
                <span class="detail">{node.detail}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .flow {
    margin: 0 0 1.75rem;
  }

  .frame {
    overflow: hidden;
    border: 1px solid var(--app-border-default);
    border-radius: var(--radius-surface);
    background-color: var(--app-surface-panel);
    box-shadow: var(--shadow-card);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .header {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.5625rem 0.875rem;
    border-bottom: 1px solid var(--app-border-subtle);
    background-color: var(--app-surface-code-header);
    color: var(--doc-text-muted);
    font-family: var(--sl-font-mono), ui-monospace, monospace;
    font-size: 0.71875rem;
  }

  .kind {
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--app-border-default);
    border-radius: var(--radius-detail);
    color: var(--doc-text-faint);
    font-size: 0.65625rem;
  }

  .canvas {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.625rem 1.25rem;
  }

  .path,
  .outputs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .path li {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .node {
    display: flex;
    flex-direction: column;
    gap: 0.1875rem;
    min-width: 8.25rem;
    padding: 0.6875rem 0.875rem;
    border: 1px solid var(--app-border-strong);
    border-radius: 0.5rem;
    background-color: var(--app-surface-field);
    text-align: center;
  }

  .node.dashed {
    border-style: dashed;
    border-color: var(--app-border-default);
    background-color: transparent;
  }

  .label {
    color: var(--app-text-strong);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .node.dashed .label {
    color: var(--app-text);
    font-weight: 500;
  }

  .detail {
    color: var(--doc-text-faint);
    font-family: var(--sl-font-mono), ui-monospace, monospace;
    font-size: 0.65625rem;
  }

  .arrow {
    color: var(--doc-text-faint);
    font-size: 0.8125rem;
  }

  .connector {
    width: 1px;
    height: 1.625rem;
    background-color: var(--app-border-strong);
  }

  figcaption {
    margin-top: 0.75rem;
    max-width: 72ch;
    color: var(--doc-text-muted);
    font-size: 0.84375rem;
    line-height: 1.6;
    text-wrap: pretty;
  }
</style>
